<!DOCTYPE html><html lang="uk"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] — ShoppingSystem</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body>
<header><nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4"><div class="container"><a class="navbar-brand" asp-controller="Home" asp-action="Index">ShoppingSystem</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Меню"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNav"><ul class="navbar-nav">
<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Головна</a></li><li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Товари</a></li><li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Покупці</a></li><li class="nav-item"><a class="nav-link" asp-controller="Supermarkets" asp-action="Index">Супермаркети</a></li><li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="Index">Замовлення</a></li></ul></div></div></nav></header>
<div class="container"><main role="main" class="pb-5">@RenderBody()</main></div><footer class="border-top py-3"><div class="container">Лабораторна робота №5 — Реєстрація замовлень</div></footer><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>