@model ShoppingSystem.ViewModels.OrderCreateViewModel
<input type="hidden" asp-for="Id" /><div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3 mb-4">
<div class="col-md-4"><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"><option value="">Оберіть покупця</option></select><span asp-validation-for="CustomerId" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="SupermarketId" class="form-label"></label><select asp-for="SupermarketId" asp-items="Model.Supermarkets" class="form-select"><option value="">Оберіть супермаркет</option></select><span asp-validation-for="SupermarketId" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="OrderDate" class="form-label"></label><input asp-for="OrderDate" type="date" class="form-control" /><span asp-validation-for="OrderDate" class="text-danger"></span></div>
</div>
<p>Позначте товари та введіть кількість. Ціни й сума визначаються сервером за поточним каталогом.</p>
<table class="table table-striped"><thead><tr><th>Обрати</th><th>Товар</th><th>Ціна, грн</th><th>Кількість</th></tr></thead><tbody>
@for (var i = 0; i < Model.Items.Count; i++) {
<tr><td><input asp-for="Items[i].Selected" class="form-check-input" aria-label="Обрати товар" /><input asp-for="Items[i].ProductId" type="hidden" /><span asp-validation-for="Items[i].ProductId" class="text-danger"></span></td><td>@Model.Items[i].Name</td><td>@Model.Items[i].Price.ToString("F2")</td><td><input asp-for="Items[i].Quantity" type="number" class="form-control" aria-label="Кількість товару" /><span asp-validation-for="Items[i].Quantity" class="text-danger"></span></td></tr>
}
</tbody></table>
@if (Model.Items.Count == 0) { <p class="alert alert-warning">Спочатку створіть товари у каталозі.</p> }
<button type="submit" class="btn btn-primary">Зберегти замовлення</button> <a asp-action="Index" class="btn btn-secondary">Скасувати</a>