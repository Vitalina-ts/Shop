@model IEnumerable<ShoppingSystem.Models.Product>
@{ var items = Model; }
<h1>Товари</h1><a asp-action="Create" class="btn btn-success mb-3">Створити</a><div class="table-responsive"><table class="table table-striped"><thead><tr><th>ID</th><th>Назва</th><th>Ціна, грн</th><th>Дії</th></tr></thead><tbody>@foreach (var item in items) { <tr><td>@item.Id</td><td>@item.Name</td><td>@item.Price.ToString("F2")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Редагувати</a> | <a asp-action="Details" asp-route-id="@item.Id">Відомості</a> | <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a></td></tr> }</tbody></table></div>@if (!items.Any()) { <p>Записів не знайдено.</p> }