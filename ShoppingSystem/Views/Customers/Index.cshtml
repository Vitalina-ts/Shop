@model ShoppingSystem.ViewModels.CustomerListViewModel
@{ var items = Model.Customers; }
<form method="get" class="d-flex gap-2 mb-3"><input name="search" value="@Model.Search" class="form-control" placeholder="Ім’я або прізвище" aria-label="Пошук" /><input type="hidden" name="sort" value="@Model.Sort" /><button class="btn btn-primary">Пошук</button><a asp-action="Index" class="btn btn-secondary text-nowrap">Повний список</a></form>
<h1>Покупці</h1><a asp-action="Create" class="btn btn-success mb-3">Створити</a><div class="table-responsive"><table class="table table-striped"><thead><tr><th>ID</th><th>Ім’я</th><th><a asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="@(Model.Sort == "name_desc" ? "name" : "name_desc")">Прізвище ↕</a></th><th><a asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="@(Model.Sort == "address" ? "address_desc" : "address")">Адреса ↕</a></th><th>Знижка, %</th><th>Дії</th></tr></thead><tbody>@foreach (var item in items) { <tr><td>@item.Id</td><td>@item.FirstName</td><td>@item.LastName</td><td>@item.Address</td><td>@item.Discount</td><td><a asp-action="Edit" asp-route-id="@item.Id">Редагувати</a> | <a asp-action="Details" asp-route-id="@item.Id">Відомості</a> | <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a></td></tr> }</tbody></table></div>@if (!items.Any()) { <p>Записів не знайдено.</p> }